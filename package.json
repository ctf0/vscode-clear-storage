{
    "name": "clear-storage",
    "displayName": "Clear Storage",
    "description": "clear workspace & global storage",
    "version": "0.0.5",
    "publisher": "ctf0",
    "repository": "https://github.com/ctf0/vscode-clear-storage",
    "engines": {
        "vscode": "^1.110.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onStartupFinished"
    ],
    "main": "./out/main",
    "contributes": {
        "commands": [
            {
                "command": "extension.clearWorkSpacesStorage",
                "title": "Clear WorkSpacesStorage",
                "category": "Storage"
            },
            {
                "command": "extension.clearCurrentWorkSpaceStorage",
                "title": "Clear (Current) WorkSpaceStorage",
                "category": "Storage",
                "when": "workspaceFolderCount > 0"
            },
            {
                "command": "extension.clearGlobalStorage",
                "title": "Clear GlobalStorage",
                "category": "Storage"
            },
            {
                "command": "extension.openCurrentWorkSpaceStorage",
                "title": "Open (Current) WorkSpaceStorage",
                "category": "Storage",
                "when": "workspaceFolderCount > 0"
            },
            {
                "command": "extension.openGlobalStorage",
                "title": "Open GlobalStorage",
                "category": "Storage"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run esbuild-base -- --pure:console.log --minify",
        "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/main.js --external:vscode --external:fs-extra --format=cjs --platform=node",
        "esbuild": "npm run esbuild-base -- --sourcemap",
        "esbuild-watch": "npm run esbuild-base -- --sourcemap --watch",
        "watch": "npm run esbuild"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "@types/vscode": "^1.110.0",
        "esbuild": "^0.28.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "fs-extra": "^11.4.0"
    }
}
